<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smart.seriesblock"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />

    <!-- signature|appop; Telecom only binds non-UI InCallServices holding it.
         Grant once: adb shell appops set com.smart.seriesblock MANAGE_ONGOING_CALLS allow -->
    <uses-permission android:name="android.permission.MANAGE_ONGOING_CALLS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher">

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Non-UI InCallService; bound by Telecom because of MANAGE_ONGOING_CALLS above -->
        <service
            android:name=".BlockService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>
</manifest>
